# ============================================================================
# V9200 软路由环境变量
# 复制为 v9200.env 后按你的实际网络修改。所有脚本都从这里读。
# ============================================================================

# ---- 容器 ----
CONTAINER=openwrt
DATA=/var/lib/docker/volumes/openwrt-data/_data
LOG_DIR=$DATA/logs

# ---- WAN (上游) ----
# 你的广域网地址。注意：脚本会自动加 /32，不要在这里写 /24
WAN_IP=203.0.113.10
WAN_GW=203.0.113.1
WAN_IF=eth16.16
WAN_MAC=02:00:00:00:21:10

# ---- LAN (内网) ----
LAN_CIDR=192.168.10.0/24
LAN_IP=192.168.10.1
LAN_DHCP_START=192.168.10.100
LAN_DHCP_END=192.168.10.200

# ---- DNS 上游 ----
DNS_UPSTREAM_1=223.5.5.5
DNS_UPSTREAM_2=119.29.29.29

# ---- 通道 IP (容器 <-> 宿主 veth) ----
VETH_HOST=192.168.99.1
VETH_CONT=192.168.99.2

# ---- LMT 管理口 ----
LMT_IP=192.254.1.16
LMT_MACVLAN=192.254.1.17

# ---- NAT 实现 ----
# natd = C 版 (推荐, 8.3M pkt/s)
# py   = Python 回退 (39k pkt/s, 约 455 Mbps 上限)
NAT_IMPL=natd
NAT_MTU=1500

# ---- 守护 ----
WATCHDOG_INTERVAL=15
